[%General]
author=Hokku contributors
comment=Haiku's own control look, as Hokku draws it.
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
click_behavior=0
left_tabs=true
attach_active_tab=true
joined_inactive_tabs=false
embedded_tabs=false
mirror_doc_tabs=true
no_active_tab_separator=true
active_tab_overlap=0
bold_active_tab=false
group_toolbar_buttons=false
toolbar_item_spacing=1
toolbar_interior_spacing=2
toolbar_separator_thickness=4
center_toolbar_handle=true
slim_toolbars=false
toolbutton_style=0
spread_progressbar=true
progressbar_thickness=0
spread_header=true
spread_menuitems=true
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
composite=false
menu_shadow_depth=0
tooltip_shadow_depth=0
submenu_overlap=0
menu_separator_height=6
scrollable_menu=true
translucent_windows=false
blurring=false
popup_blurring=false
animate_states=false
no_inactiveness=true
no_window_pattern=true
splitter_width=7
scroll_width=15
scroll_min_extent=20
center_scrollbar_indicator=true
scroll_arrows=true
scrollbar_in_view=false
transient_scrollbar=false
tree_branch_line=false
groupbox_top_label=false
slider_width=7
slider_handle_width=14
slider_handle_length=18
check_size=17
tooltip_delay=-1
submenu_delay=250
layout_spacing=6
layout_margin=8
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
inline_spin_indicators=false
inline_spin_separator=false
vertical_spin_indicators=false
spin_button_width=19
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=false
square_combo_button=false
fill_rubberband=false
remove_extra_frames=false
dialog_button_layout=0

[GeneralColors]
window.color=#d8d8d8
base.color=#ffffff
alt.base.color=#f4f4f4
button.color=#dedede
light.color=#ffffff
mid.light.color=#e7e7e7
dark.color=#989898
mid.color=#c8c8c8
shadow.color=#727272
highlight.color=#bebebe
inactive.highlight.color=#bebebe
tooltip.base.color=#ffffd8
text.color=#000000
window.text.color=#000000
button.text.color=#000000
disabled.text.color=#848484
tooltip.text.color=#000000
highlight.text.color=#000000
link.color=#3366bb
link.visited.color=#91709b
progress.indicator.text.color=#000000

[Hacks]
transparent_ktitle_label=false
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
transparent_pcmanfm_view=false
transparent_menutitle=true
respect_darkness=false
force_size_grip=false
tint_on_mouseover=0
no_selection_tint=true
disabled_icon_opacity=50
normal_default_pushbutton=true
iconless_pushbutton=false
transparent_arrow_button=true
iconless_menu=false
single_top_toolbar=false
style_vertical_toolbars=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
focusFrame=true
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000
text.shadow=false
text.bold=false
text.margin.top=5
text.margin.bottom=5
text.margin.left=8
text.margin.right=8
text.iconspacing=4
min_width=5font

[PanelButtonTool]
inherits=PanelButtonCommand
focusFrame=false
text.margin.left=4
text.margin.right=4
min_width=0

[ToolbarButton]
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[Dock]
inherits=PanelButtonCommand
frame.element=dock
interior.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
focusFrame=false
indicator.element=mdi

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=docktitle
focusFrame=false
text.bold=true
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=button
interior.element=button
indicator.element=spin
indicator.size=9
focusFrame=false

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
focusFrame=false
text.margin.top=1
text.margin.bottom=1
text.margin.left=4
text.margin.right=2
min_width=0

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
focusFrame=false
text.margin.top=1
text.margin.bottom=1
text.margin.left=4
text.margin.right=2
min_width=0

[Focus]
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=false

[GenericFrame]
frame=true
frame.element=common
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=false
text.normal.color=#000000

[LineEdit]
frame=true
frame.element=lineedit
interior=true
interior.element=lineedit
frame.top=2
frame.left=2
frame.bottom=2
frame.right=2
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3
indicator.element=carrow
indicator.size=16

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
indicator.size=12
focusFrame=false
frame.top=6
frame.bottom=1
frame.left=2
frame.right=2
text.margin.top=0
text.margin.bottom=2
text.margin.left=8
text.margin.right=8
min_width=0

[TabFrame]
frame=true
frame.element=tabframe
interior=false
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[TabBarFrame]
frame=false
interior=false

[TreeExpander]
indicator.element=tree
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
indicator.element=arrow
indicator.size=8
focusFrame=false
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
min_width=0

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
frame=false
interior=true
interior.element=toolbar
indicator.element=toolbar
indicator.size=6
text.normal.color=#000000
text.focus.color=#000000

[Slider]
frame=true
frame.element=slider
interior=true
interior.element=slider
frame.top=4
frame.bottom=4
frame.left=0
frame.right=0
focusFrame=false

[SliderCursor]
frame=false
interior=true
interior.element=slidercursor

[Progressbar]
frame=true
frame.element=progress
interior=true
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin=0
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000
text.bold=false

[ProgressbarContents]
frame=true
frame.element=progress-pattern
interior=true
interior.element=progress-pattern
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ItemView]
frame=true
frame.element=itemview
interior=true
interior.element=itemview
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[Splitter]
frame=false
interior=true
interior.element=splitter
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
indicator.element=sarrow
indicator.size=15

[ScrollbarSlider]
frame=true
frame.element=sslider
interior=true
interior.element=sslider
frame.top=1
frame.bottom=1
frame.left=2
frame.right=2
indicator.element=sgrip
indicator.size=3

[ScrollbarGroove]
frame=true
frame.element=sgroove
interior=true
interior.element=sgroove
frame.top=1
frame.bottom=0
frame.left=1
frame.right=1

[MenuItem]
frame=true
frame.element=menuitem
interior=true
interior.element=menuitem
indicator.element=mitem
indicator.size=9
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=1
text.margin.bottom=1
text.margin.left=6
text.margin.right=6
min_height=0
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[MenuBar]
frame=true
frame.element=menubar
interior=true
interior.element=menubar
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#000000

[MenuBarItem]
frame=true
frame.element=menubaritem
interior=true
interior.element=menubaritem
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[TitleBar]
frame=false
interior=true
interior.element=titlebar
indicator.element=mdi
indicator.size=12
text.normal.color=#505050
text.focus.color=#000000
text.bold=true
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[ComboBox]
inherits=PanelButtonCommand
frame.element=button
interior.element=button
indicator.element=carrow
indicator.size=16
frame.top=3
frame.left=3
frame.bottom=3
frame.right=3
text.margin.left=6
text.margin.right=2
min_width=0
min_height=1.9font

[Menu]
frame=true
frame.element=menu
interior=true
interior.element=menu
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#000000

[GroupBox]
frame=true
frame.element=group
interior=false
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.bold=true

[ToolTip]
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=#000000

[StatusBar]
frame=false
interior=false

[Window]
interior=false
frame=false
