+/*
+ * Haiku and Gonx have frames of their own here; any other name is one of
+ * Hokku's decorators. Which is drawn is settled once the theme is read
+ * (ssd_hokku_theme_sizes()): Hokku's libdecorator draws whichever it has.
+ */
+static enum lab_hokku_frame
+parse_hokku_frame(const char *str)
+{
+	if (!strcasecmp(str, "Haiku")) {
+		return LAB_HOKKU_FRAME_HAIKU;
+	} else if (!strcasecmp(str, "Gonx")) {
+		return LAB_HOKKU_FRAME_GONX;
+	} else if (!*str || !strcasecmp(str, "none")
+			|| !strcasecmp(str, "Default")) {
+		return LAB_HOKKU_FRAME_NONE;
+	} else {
+		return LAB_HOKKU_FRAME_DECOR;
+	}
+}
