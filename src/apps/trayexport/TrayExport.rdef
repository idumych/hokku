/*
 * TrayExport.rdef
 */

resource app_signature "application/x-vnd.Hokku-TrayExport";

resource app_name_catalog_entry "x-vnd.Hokku-TrayExport:System name:TrayExport";

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "TrayExport",
	long_info  = "TrayExport: apps' Deskbar items in the desktop's tray"
};
