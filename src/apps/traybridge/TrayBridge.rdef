/*
 * TrayBridge.rdef
 */

resource app_signature "application/x-vnd.Hokku-TrayBridge";

resource app_name_catalog_entry "x-vnd.Hokku-TrayBridge:System name:TrayBridge";

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "TrayBridge",
	long_info  = "TrayBridge: the desktop's tray icons in the Deskbar"
};

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;
